# Salin ke .env lalu isi. File .env tidak boleh di-commit.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/riksa_warga?charset=utf8mb4
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=720

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
REPORT_RATE_LIMIT_PER_10MIN=10
OBSERVATION_STALE_MINUTES=30
ENGINE_TICK_SECONDS=30
LIVE_SIM_SECONDS=3   # simulator TMA semua pos (0 = mati)

# mock = tidak mengirim apa pun, hanya mencatat; live = kirim ke Telegram Bot API
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# SMS (PRD v2). mock = hanya dicatat. live = POST JSON {to, message, sender} ke SMS_API_URL dengan
# header Authorization: Bearer <SMS_API_KEY>; sesuaikan adaptor di app/services/notifier.py dengan penyedia pilihan.
SMS_MODE=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=RIKSAWARGA

# Parameter awal untuk diuji (asumsi, bukan ambang ilmiah)
DANGER_RADIUS_M=1500
UNCONFIRMED_MINUTES=15
CONDITION_STALE_HOURS=6
ANNOUNCEMENT_TTL_HOURS=12
LOCATION_RETENTION_HOURS=72

# Password semua akun demo yang dibuat scripts/seed.py (hanya untuk demo lokal)
SEED_PASSWORD=riksa-demo-123
